@@ -0,0 +1,61 @@
+package com.threedrd.nextftc.logging
+
+import com.qualcomm.robotcore.util.RobotLog
+import dev.nextftc.core.components.Component
+import java.util.concurrent.Executors
+import java.util.concurrent.ScheduledExecutorService
+import java.util.concurrent.TimeUnit.MILLISECONDS
+
+class HangMonitor(
+    private val timeoutNanos: Long = 2_000_000_000,
+    private val now: () -> Long = System::nanoTime,
+    private val report: (String) -> Unit = { RobotLog.ee("HangMonitor", it) }
+) : Component, AutoCloseable {
+    internal var worker: ScheduledExecutorService? = null
+    private var reported: LoopBreadcrumbs.Breadcrumb? = null
+
+    override fun preInit() {
+        if (worker != null) return
+        reported = null
+        LoopBreadcrumbs.mark("Initialization between components")
+        worker = Executors.newSingleThreadScheduledExecutor { task ->
+            Thread(task, "LoopHangMonitor").apply { isDaemon = true }
+        }.apply { scheduleAtFixedRate({ check() }, 250, 250, MILLISECONDS) }
+    }
+
+    internal fun check() {
+        val current = LoopBreadcrumbs.current
+        val elapsed = now() - current.since
+        if (elapsed < timeoutNanos || current === reported) return
+        reported = current
+        // Bypass telemetry and Logging's shared history: either could be blocked.
+        report("No loop progress for ${elapsed / 1_000_000} ms | ${current.phase}")
+    }
+
+    fun watch(component: Component) = MonitoredComponent(component)
+
+    override fun preWaitForStart() = LoopBreadcrumbs.mark("Init loop / OpMode.onWaitForStart")
+    override fun postWaitForStart() = LoopBreadcrumbs.mark("CommandManager.postWaitForStart / init loop transition")
+    override fun preUpdate() = LoopBreadcrumbs.mark("Active loop / OpMode.onUpdate")
+    override fun postUpdate() = LoopBreadcrumbs.mark("CommandManager.postUpdate / active loop transition")
+    override fun postStop() = close()
+
+    override fun close() {
+        worker?.shutdownNow()
+        worker = null
+    }
+}
+
+class MonitoredComponent(val component: Component) : Component {
+    private val name = component.javaClass.simpleName
+    override fun preInit() = LoopBreadcrumbs.during("$name.preInit") { component.preInit() }
+    override fun postInit() = LoopBreadcrumbs.during("$name.postInit") { component.postInit() }
+    override fun preWaitForStart() = LoopBreadcrumbs.during("$name.preWaitForStart") { component.preWaitForStart() }
+    override fun postWaitForStart() = LoopBreadcrumbs.during("$name.postWaitForStart") { component.postWaitForStart() }
+    override fun preStartButtonPressed() = LoopBreadcrumbs.during("$name.preStartButtonPressed") { component.preStartButtonPressed() }
+    override fun postStartButtonPressed() = LoopBreadcrumbs.during("$name.postStartButtonPressed") { component.postStartButtonPressed() }
+    override fun preUpdate() = LoopBreadcrumbs.during("$name.preUpdate") { component.preUpdate() }
+    override fun postUpdate() = LoopBreadcrumbs.during("$name.postUpdate") { component.postUpdate() }
+    override fun preStop() = LoopBreadcrumbs.during("$name.preStop") { component.preStop() }
+    override fun postStop() = LoopBreadcrumbs.during("$name.postStop") { component.postStop() }
+}
