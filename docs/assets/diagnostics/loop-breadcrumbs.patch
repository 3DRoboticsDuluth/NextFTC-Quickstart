+++ b/3drdNextFTC/src/main/java/com/threedrd/nextftc/logging/LoopBreadcrumbs.kt
@@ -0,0 +1,21 @@
+package com.threedrd.nextftc.logging
+
+object LoopBreadcrumbs {
+    data class Breadcrumb(val phase: String, val since: Long)
+
+    @Volatile
+    var current = Breadcrumb("Idle", System.nanoTime())
+        internal set
+
+    fun mark(phase: String) { current = Breadcrumb(phase, System.nanoTime()) }
+
+    fun <T> during(phase: String, action: () -> T): T {
+        val previous = current.phase
+        mark(phase)
+        try {
+            return action()
+        } finally {
+            mark(previous)
+        }
+    }
+}
