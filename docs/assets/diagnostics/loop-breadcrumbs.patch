+package com.threedrd.nextftc.logging
+
+import com.qualcomm.robotcore.util.RobotLog
+import dev.nextftc.core.components.Component
+import org.junit.Assert.*
+import org.junit.Test
+import org.mockito.Mockito.*
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit.SECONDS
+
+class HangMonitorTests {
+    @Test
+    fun breadcrumbsExposeNestedPhasesAndRestoreTheirCallerEvenAfterFailure() {
+        LoopBreadcrumbs.mark("Loop")
+        val result = LoopBreadcrumbs.during("Subsystem.periodic") {
+            assertEquals("Subsystem.periodic", LoopBreadcrumbs.current.phase)
+            LoopBreadcrumbs.during("Motor.update") { assertEquals("Motor.update", LoopBreadcrumbs.current.phase) }
+            assertEquals("Subsystem.periodic", LoopBreadcrumbs.current.phase)
+            42
+        }
+        assertEquals(42, result)
+        assertEquals("Loop", LoopBreadcrumbs.current.phase)
+        val failure = IllegalStateException("test")
+        try {
+            LoopBreadcrumbs.during("Failure") { throw failure }
+            fail("Expected the original failure")
+        } catch (caught: IllegalStateException) {
+            assertSame(failure, caught)
+        }
+        assertEquals("Loop", LoopBreadcrumbs.current.phase)
+    }
+
+    @Test
+    fun monitorReportsOncePerStalledPhaseAndRearmsAfterProgress() {
+        var now = 0L
+        val messages = mutableListOf<String>()
+        val monitor = HangMonitor(now = { now }, report = messages::add)
+        LoopBreadcrumbs.current = LoopBreadcrumbs.Breadcrumb("Turret.periodic", 0)
+        now = 1_999_999_999
+        monitor.check()
+        assertTrue(messages.isEmpty())
+        now = 2_000_000_000
+        monitor.check()
+        assertEquals(listOf("No loop progress for 2000 ms | Turret.periodic"), messages)
+        now = 9_000_000_000
+        monitor.check()
+        assertEquals(1, messages.size)
+        LoopBreadcrumbs.current = LoopBreadcrumbs.Breadcrumb("TelemetryComponent.postUpdate", now)
+        monitor.check()
+        assertEquals(1, messages.size)
+        now += 2_000_000_000
+        monitor.check()
+        assertEquals("No loop progress for 2000 ms | TelemetryComponent.postUpdate", messages.last())
+        assertEquals(2, messages.size)
+    }
+
+    @Test
+    fun monitorWritesDirectlyToRobotLog() {
+        LoopBreadcrumbs.current = LoopBreadcrumbs.Breadcrumb("BindingsComponent.preUpdate", 0)
+        mockStatic(RobotLog::class.java).use { robotLog ->
+            HangMonitor(now = { 2_000_000_000 }).check()
+            robotLog.verify { RobotLog.ee("HangMonitor", "No loop progress for 2000 ms | BindingsComponent.preUpdate") }
+        }
+    }
+
+    @Test
+    fun independentDaemonReportsWhileTheCallingThreadWaitsAndStopsWithoutLeaks() {
+        val captured = CountDownLatch(1)
+        var reportingThread: Thread? = null
+        val monitor = HangMonitor(timeoutNanos = 0, report = {
+            reportingThread = Thread.currentThread()
+            captured.countDown()
+        })
+        try {
+            monitor.preInit()
+            val worker = monitor.worker!!
+            monitor.preInit()
+            assertSame(worker, monitor.worker)
+            assertTrue(captured.await(3, SECONDS))
+            assertEquals("LoopHangMonitor", reportingThread!!.name)
+            assertTrue(reportingThread.isDaemon)
+            assertNotSame(Thread.currentThread(), reportingThread)
+            monitor.postStop()
+            assertTrue(worker.isShutdown)
+            assertTrue(worker.awaitTermination(3, SECONDS))
+            assertNull(monitor.worker)
+            monitor.preInit()
+            assertNotSame(worker, monitor.worker)
+        } finally {
+            monitor.close()
+            monitor.close()
+        }
+        assertNull(monitor.worker)
+    }
+
+    @Test
+    fun componentCallbacksAreForwardedOnceWithNamedBreadcrumbs() {
+        val monitor = HangMonitor()
+        val component = mock(Component::class.java)
+        val wrapper = monitor.watch(component)
+        assertSame(component, wrapper.component)
+        for (method in Component::class.java.methods.filter { it.parameterCount == 0 && it.returnType == Void.TYPE }) {
+            LoopBreadcrumbs.mark("Caller")
+            doAnswer {
+                assertEquals("${component.javaClass.simpleName}.${method.name}", LoopBreadcrumbs.current.phase)
+                null
+            }.`when`(component).let { method.invoke(it) }
+            method.invoke(wrapper)
+            method.invoke(verify(component))
+            assertEquals("Caller", LoopBreadcrumbs.current.phase)
+        }
+        verifyNoMoreInteractions(component)
+        monitor.preWaitForStart()
+        assertEquals("Init loop / OpMode.onWaitForStart", LoopBreadcrumbs.current.phase)
+        monitor.postWaitForStart()
+        assertEquals("CommandManager.postWaitForStart / init loop transition", LoopBreadcrumbs.current.phase)
+        monitor.preUpdate()
+        assertEquals("Active loop / OpMode.onUpdate", LoopBreadcrumbs.current.phase)
+        monitor.postUpdate()
+        assertEquals("CommandManager.postUpdate / active loop transition", LoopBreadcrumbs.current.phase)
+    }
+}
